OPENAI_API_KEY=
FLASK_ENV=development
FLASK_APP=app.py
VECTOR_STORE_DIR=storage/chroma_db
MEDICAL_BOOK_PATH=data/medical_book.pdf
OPENAI_MODEL=gpt-5.4-mini
OPENAI_CHAT_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_NORMALIZATION_MODEL=gpt-4.1-mini
ENABLE_WEB_FALLBACK=true
WEB_FALLBACK_MODEL=gpt-4.1-mini
WEB_FALLBACK_ALLOWED_DOMAINS=who.int,cdc.gov,nih.gov,medlineplus.gov,mayoclinic.org,nhs.uk,clevelandclinic.org,hopkinsmedicine.org,fda.gov
WEB_FALLBACK_MAX_SOURCES=5
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MIN_RELEVANCE_SCORE=0.42
MIN_KEYWORD_COVERAGE=0.60
STRONG_RELEVANCE_SCORE=0.62
NORMALIZATION_HIGH_CONFIDENCE=0.75
NORMALIZATION_MEDIUM_CONFIDENCE=0.45
NORMALIZATION_CACHE_SIZE=128
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
